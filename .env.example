# Copy to .env.local for local development. Everything here is read on the server only, except
# NEXT_PUBLIC_TURNSTILE_SITE_KEY, which is public by design.

# Ogasela.API base URL, including the /api/v1 prefix. The browser never calls the API directly:
# pages and Server Actions call it from the Next server, so the API needs no CORS entry for this site.
# Production: https://api.ogasela.com/api/v1
OGASELA_API_URL=http://localhost:8080/api/v1

# This site's public URL (scheme + host, no path). Payment and Google/Facebook sign-in return
# here. Must match Ogasela.API's Payments:AllowedReturnUrls entry ("<this>/payments/return") and
# the redirect URI registered with Google and Facebook ("<this>/auth/callback").
OGASELA_PUBLIC_URL=http://localhost:3001

# Social sign-in - blank shows the button but says it isn't available yet (same as the app).
# Google: the OAuth *web* client id (the same one as Ogasela.API's GOOGLE_WEB_CLIENT_ID).
OGASELA_GOOGLE_CLIENT_ID=
# Facebook Login app id (the same app as Ogasela.API's FACEBOOK_LOGIN_APP_ID).
OGASELA_FACEBOOK_APP_ID=

# Minutes without any page load or action before a signed-in session is ended (mobile app: 10).
OGASELA_AUTO_LOGOUT_MINUTES=10

# Optional support channels shown in the footer and on the listing page. Leave blank to hide.
OGASELA_SUPPORT_PHONE=
# A click-to-chat link, e.g. https://wa.me/2348012345678
OGASELA_SUPPORT_WHATSAPP_URL=

# ---- From OgaselaWebsite (same names as ogasela.com's existing deployment) ----

# Cloudflare Turnstile site key for the contact, waiting-list, testers and account-deletion forms.
# Public by design (the only browser-visible setting); the secret key lives on Ogasela.API only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Launch switches - read on the server (src/config/launch.ts), fixed at build time, so rebuild
# and redeploy after changing them.
# false: every "Get the app" becomes "Join waiting list" and the store badges say "Coming soon".
NEXT_APP_LIVE=false
# Store listing URLs (https). A badge only becomes a link once NEXT_APP_LIVE=true and its URL is set.
NEXT_APPSTORE_URL=
NEXT_PLAYSTORE_URL=
# Paystack donation page URL (https). Empty hides the donate button and shows a "coming soon" note.
NEXT_DONATION_PAGE_URL=
